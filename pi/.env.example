# Pi / edge service — copy:  cp .env.example .env
# Dashboard secrets (PORTAL_SECRET_KEY) belong in web/.env only.

CAMERA_IP=122.175.45.21
CAMERA_USER=admin
CAMERA_PASS=your_camera_password
RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_SUBTYPE=1

DAYCARE_NAME=Sunshine Daycare
DEPLOY_HEADLESS=true

VIOLENCE_CONF=0.60
VIOLENCE_EVERY_N=4
# Alert when CONFIRM_HITS of the last CONFIRM_WINDOW inferences are violence
CONFIRM_HITS=8
CONFIRM_WINDOW=10
ALERT_COOLDOWN_SEC=300
INFER_PAUSE_AFTER_ALERT_SEC=900
DECODE_WIDTH=416
DECODE_FPS=5
SAVE_CLIPS=false
TORCH_NUM_THREADS=2

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
SMS_TO=
TWILIO_SMS_TEMPLATE=sms_internal_alerts
TWILIO_SMS_USE_TEMPLATE=true
TWILIO_SMS_MODE=template

SUPABASE_LOGGING=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Snapshot files. Same bucket name as web/.env
SUPABASE_STORAGE_BUCKET=detections

# Must match web/.env PORTAL_INGEST_KEY
# Local laptop test: http://127.0.0.1:8080
# Three sites: https://daycare-dashboard.onrender.com  (see WEB_DEPLOY.md)
PORTAL_URL=http://127.0.0.1:8080
PORTAL_INGEST_KEY=generate-a-long-random-string
