# Pi / edge service — copy:  cp .env.example .env
# Dashboard secrets (PORTAL_SECRET_KEY) belong in web/.env only.

CAMERA_IP=122.175.45.21
CAMERA_USER=admin
CAMERA_PASS=your_camera_password
RTSP_PORT=554
CAMERA_CHANNEL=1
CAMERA_SUBTYPE=1

DAYCARE_NAME=Sunshine Daycare
DEPLOY_HEADLESS=true

# best_action_ft.pt = struggle clips. best_daycare_ft.pt = calm-room tune. best.pt = original.
VIOLENCE_WEIGHTS=violence_yolov8n_cls-4/weights/best_action_ft.pt
VIOLENCE_CONF=0.60
VIOLENCE_EVERY_N=4
# Notify after this many violence frames inside the span. Calm frames do not reset it.
CONFIRM_HITS=8
CONFIRM_SPAN_SEC=45
ALERT_COOLDOWN_SEC=300
INFER_PAUSE_AFTER_ALERT_SEC=900
DECODE_WIDTH=416
DECODE_FPS=5
SAVE_CLIPS=false
TORCH_NUM_THREADS=2

# SMS via Quectel EC200U-CN on the USB Type-C cable.
# Leave MODEM_PORT empty to auto-detect /dev/ttyUSB* /dev/ttyACM*.
SMS_ENABLED=false
SMS_TO=+919000000000
MODEM_PORT=
MODEM_BAUD=115200
# MODEM_SIM_PIN=
# How often the boot keepalive pokes the modem so it does not sleep.
MODEM_WAKE_SEC=30

# Email via SMTP (personal Gmail: enable 2-Step Verification,
# then create an App Password at https://myaccount.google.com/apppasswords).
# fallback = send only when the USB SMS did not go out.
# always = send on every alert as well as SMS and push.
EMAIL_ENABLED=false
EMAIL_MODE=fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_TO=recipient1@example.com,recipient2@example.com
# EMAIL_FROM defaults to SMTP_USER
# EMAIL_SUBJECT=Alert: Safety incident at Daycare
# EMAIL_BODY=Alert: Unusual / Safety incident reported at Daycare, Please check.

SUPABASE_LOGGING=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Snapshot files. Same bucket name as web/.env
SUPABASE_STORAGE_BUCKET=detections

# Must match web/.env PORTAL_INGEST_KEY
# Local laptop test: http://127.0.0.1:8080
# Three sites: https://daycare-dashboard.onrender.com  (see WEB_DEPLOY.md)
PORTAL_URL=http://127.0.0.1:8080
PORTAL_INGEST_KEY=generate-a-long-random-string
